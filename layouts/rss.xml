{{- $pages := .Pages -}}
{{- if .IsHome -}}
  {{- $pages = where site.RegularPages "Section" "in" site.Params.mainSections -}}
{{- end -}}
{{- $limit := 50 -}}
{{- if gt (len $pages) $limit }}{{ $pages = first $limit $pages }}{{ end -}}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if .IsHome }}{{ site.Title }}{{ else }}{{ .Title }} · {{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ or .Description site.Params.description }}</description>
    <language>{{ site.Language.Lang }}</language>
    {{- with site.Params.author.name }}
    <managingEditor>{{ with site.Params.author.email }}{{ . }} {{ end }}({{ $.Site.Params.author.name }})</managingEditor>
    {{- end }}
    {{- with (index $pages 0) }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    <atom:link href="{{ .Permalink }}index.xml" rel="self" type="application/rss+xml" />
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ if site.Params.rssFullContent }}{{ .Content | transform.XMLEscape | safeHTML }}{{ else }}{{ .Summary | transform.XMLEscape | safeHTML }}{{ end }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
